ENVIRONMENT=development # development or production; also used as the MongoDB database name
DISCORD_TOKEN= # token from the Discord Developer Portal
DEV_IDS= # optional comma-separated user IDs allowed to run /reload
ISSUES= # optional issue tracker URL shown when a command fails
MONGO_URI= # MongoDB connection string
GEMINI_API_KEY= # API key from Google AI Studio used by the /ai feature
GEMINI_MODEL=gemini-3.6-flash # Gemini model used by the /ai feature
AI_COOLDOWN_MS=15000 # minimum time between AI replies in the same channel
